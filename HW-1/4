#include <iostream>
#include <vector>
#include <thread>
#include <cmath>
using namespace std;

void func(const vector<int>& x, const vector<int>& y, const vector<int>& z, vector<int>& d, int start, int end) {
    for (int i = start; i < end; i++) {
        d[i] = sqrt(x[i] * x[i] + y[i] * y[i] + z[i] * z[i]);
    }
}

int main() {
    int n = 4;
    vector<int> x = {1, 0, 1, 2};
    vector<int> y = {2, 3, 1, 0};
    vector<int> z = {2, 4, 1, 0};
    vector<int> d(n, 0);
    int kol = 4;
    vector<thread> threads;
    int rows = n / kol;
    for (int i = 0; i < kol; i++) {
        int start = i * rows;
        int end;
        if (i == kol - 1) {
            end = n;
        }
        else {
            end = start + rows;
        }
        threads.push_back(thread(func, ref(x), ref(y), ref(z), ref(d), start, end));
    }
    for (auto& t : threads) {
        t.join();
    }
    cout << "d:" << endl;
    for (int i = 0; i < n; i++) {
        cout << d[i] << " ";
    }
    cout << endl;
}
